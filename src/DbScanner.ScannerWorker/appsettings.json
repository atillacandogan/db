{
  "Scanner": {
    "ExecutablePath": "nmap",
    "TimeoutSeconds": 30,
    "UseSampleOutputWhenUnavailable": true
  },
  "Telemetry": {
    "CompatibilityReadinessIntervalMinutes": 5,
    "DeploymentVersion": "stage-15-resource-access"
  },
  "ScanReliability": {
    "LeaseSeconds": 60,
    "HeartbeatSeconds": 10,
    "RecoveryIntervalSeconds": 15,
    "MaxExecutionAttempts": 3,
    "RetryDelaySeconds": 5,
    "OutboxPollSeconds": 1,
    "DispatchLeaseSeconds": 30,
    "PublishTimeoutSeconds": 10
  },
  "Discovery": {
    "ConnectTimeoutMilliseconds": 1000,
    "BannerReadTimeoutMilliseconds": 1000,
    "DnsTimeoutMilliseconds": 2000,
    "JobTimeoutSeconds": 600,
    "MaxConcurrency": 8,
    "MaxProbesPerSecond": 20,
    "ProbeDelayMilliseconds": 50,
    "MaxCidrHosts": 512,
    "MaxPortsPerTarget": 16,
    "MaxBannerBytes": 512,
    "UnsupportedDatabasePorts": [6379, 27017],
    "LocalNetworkPorts": {
      "mysql": [3306, 13306],
      "postgresql": [5432, 15432],
      "mssql": [1433, 11433],
      "oracle": [1521, 11521]
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  }
}
