{
  "Scanner": {
    "ExecutablePath": "nmap",
    "TimeoutSeconds": 30,
    "UseSampleOutputWhenUnavailable": true
  },
  "Discovery": {
    "ConnectTimeoutMilliseconds": 1000,
    "BannerReadTimeoutMilliseconds": 200,
    "MaxConcurrency": 8,
    "MaxProbesPerSecond": 20,
    "MaxHosts": 256,
    "MaxBannerBytes": 512
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  }
}
