{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Authority": "http://localhost:18080/realms/dbscanner",
    "Audience": "dbscanner-api",
    "RequireHttpsMetadata": true
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=DbScannerDb;Username=postgres;Password=2003;"
  },
  "Discovery": {
    "BannerReadTimeoutMilliseconds": 1000,
    "MaxCidrHosts": 512,
    "UnsupportedDatabasePorts": [6379, 27017],
    "LocalNetworkPorts": {
      "mysql": [3306, 13306],
      "postgresql": [5432, 15432],
      "mssql": [1433, 11433],
      "oracle": [1521, 11521]
    }
  }
}
