{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Telemetry": {
    "CompatibilityReadinessIntervalMinutes": 5,
    "DeploymentVersion": "stage-15-resource-access"
  },
  "Authentication": {
    "Authority": "http://localhost:18080/realms/dbscanner",
    "Audience": "dbscanner-api",
    "RequireHttpsMetadata": true
  },
  "KeycloakAdmin": {
    "BaseUrl": "http://localhost:18080",
    "Realm": "dbscanner",
    "ClientId": "dbscanner-admin-service",
    "WebClientId": "dbscanner-web",
    "WebRedirectUri": "http://localhost:3000",
    "EmailActionLifespanSeconds": 1800,
    "RequestTimeoutSeconds": 15
  },
  "Discovery": {
    "BannerReadTimeoutMilliseconds": 1000,
    "MaxCidrHosts": 512,
    "UnsupportedDatabasePorts": [6379, 27017],
    "LocalNetworkPorts": {
      "mysql": [3306, 13306],
      "postgresql": [5432, 15432],
      "mssql": [1433, 11433],
      "oracle": [1521, 11521]
    }
  }
}
